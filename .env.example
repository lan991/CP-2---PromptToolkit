# --- CONFIGURAÇÃO DO PROVEDOR (Ollama Cloud) ---
# Gerar em: ollama.com -> Settings -> Keys (Logar com Gmail)
OLLAMA_API_KEY=insira_sua_chave_aqui

# --- MODELO ---
# Modelo padrão definido
LLM_MODEL=gpt-oss:120b

# --- PARÂMETROS DE EXECUÇÃO ---
# Temperatura sugerida para tarefas de extração e classificação
DEFAULT_TEMPERATURE=0.3
TIMEOUT_SECONDS=180