# --- CONFIGURAÇÕES DO PROVEDOR (Ollama ou Groq) ---

# Para Ollama local: http://localhost:11434/api/chat
# Para Groq Cloud: https://api.groq.com/openai/v1/chat/completions
OLLAMA_HOST=http://localhost:11434/api/chat

# --- MODELO ---
# Opções Sugeridas: 
# Local (Ollama): gpt-oss:120b ou llama3
# Nuvem (Groq): llama-3.3-70b-versatile
LLM_MODEL=gpt-oss:120b

# --- AUTENTICAÇÃO ---
# Deixe vazio se usar Ollama local. 
# Insira sua chave se usar Groq ou OpenRouter.
GROQ_API_KEY=

# --- PARÂMETROS DE EXECUÇÃO ---
DEFAULT_TEMPERATURE=0.5
TIMEOUT_SECONDS=60