# --- CONFIGURACAO DO PROVEDOR (Hugging Face API) ---
# Token obtido em huggingface.co/settings/tokens
HF_TOKEN=insira_seu_token_aqui

# --- MODELO ---
# Sugestao: meta-llama/Meta-Llama-3.1-70B-Instruct
# Verifique se voce aceitou os termos do modelo no site da Hugging Face
LLM_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# --- PARAMETROS DE EXECUCAO ---
DEFAULT_TEMPERATURE=0.5
TIMEOUT_SECONDS=180